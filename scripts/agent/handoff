#!/usr/bin/env python3
"""Emit a schema-valid, redacted handoff snapshot without mutating Git or Beads."""
from __future__ import annotations
import hashlib,json,subprocess,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]
def git(*a): return subprocess.check_output(["git",*a],cwd=ROOT,text=True).strip()
bead=sys.argv[1] if len(sys.argv)>1 else "boring-cdc-m0-scaffold"
head=git("rev-parse","HEAD"); base=git("merge-base","HEAD","origin/epic/boring-cdc-m0")
paths=[x for x in git("status","--porcelain").splitlines()]
changed=[x[3:] for x in paths]
world=hashlib.sha256((head+"\n"+"\n".join(changed)).encode()).hexdigest()
out={"schema_version":"handoff/v1","bead_id":bead,"world_state_digest":world,"base_sha":base,"head_sha":head,"dirty":{"is_dirty":bool(paths),"paths":changed},"changed_paths":changed,"touched_ids":[],"checks":{"completed":[],"failed":[],"stale":[]},"facts":["generated from displayed git commands"],"observations":[],"hypotheses":[],"intents":{"active":[],"ambiguous":[]},"risks":[],"unsafe_repeats":["do not claim, commit, or push through this read-only helper"],"next_safe_command":f"scripts/agent/context {bead}","log_references":[],"redaction":{"checked":True,"secrets_found":0}}
print(json.dumps(out,sort_keys=True))
