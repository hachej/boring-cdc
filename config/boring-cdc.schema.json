{
  "$id": "https://boring-cdc.dev/config/boring-cdc.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failure_policy": {
      "additionalProperties": false,
      "properties": {
        "base_ms": {
          "const": 250,
          "description": "// M0-PROVISIONAL: boring-cdc-d-failure-policy"
        },
        "cap_ms": {
          "const": 30000,
          "description": "// M0-PROVISIONAL: boring-cdc-d-failure-policy"
        },
        "max_attempts": {
          "const": 10,
          "description": "// M0-PROVISIONAL: boring-cdc-d-failure-policy"
        },
        "version": {
          "const": 1,
          "description": "// M0-PROVISIONAL: boring-cdc-d-failure-policy"
        }
      },
      "required": [
        "version",
        "base_ms",
        "cap_ms",
        "max_attempts"
      ],
      "type": "object"
    },
    "journal": {
      "additionalProperties": false,
      "properties": {
        "busy_timeout_ms": {
          "const": 5000,
          "description": "// M0-PROVISIONAL: boring-cdc-d-sqlite"
        },
        "max_readers": {
          "const": 16,
          "description": "// M0-PROVISIONAL: boring-cdc-d-sqlite"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sqlite_version": {
          "const": "3.45.3",
          "description": "// M0-PROVISIONAL: boring-cdc-d-sqlite"
        }
      },
      "required": [
        "path",
        "sqlite_version",
        "busy_timeout_ms",
        "max_readers"
      ],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "event_bytes": {
          "const": 8388608,
          "description": "// M0-PROVISIONAL: boring-cdc-d-values"
        },
        "key_bytes": {
          "const": 1024,
          "description": "// M0-PROVISIONAL: boring-cdc-d-keys"
        },
        "row_bytes": {
          "const": 4194304,
          "description": "// M0-PROVISIONAL: boring-cdc-d-values"
        },
        "scalar_bytes": {
          "const": 1048576,
          "description": "// M0-PROVISIONAL: boring-cdc-d-values"
        }
      },
      "required": [
        "scalar_bytes",
        "row_bytes",
        "event_bytes",
        "key_bytes"
      ],
      "type": "object"
    },
    "security": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "const": "RFC8785-JCS-SHA256",
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "confirmation_expiry_seconds": {
          "const": 300,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "nonce_bits": {
          "const": 128,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "nonce_encoding": {
          "const": "base64url-unpadded",
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "read_timeout_seconds": {
          "const": 10,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "redaction_max_bytes": {
          "const": 65536,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "redaction_max_depth": {
          "const": 8,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "request_bytes": {
          "const": 1048576,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "response_bytes": {
          "const": 4194304,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "tls_minimum": {
          "const": "1.2",
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "tls_preferred": {
          "const": "1.3",
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        },
        "write_timeout_seconds": {
          "const": 30,
          "description": "// M0-PROVISIONAL: boring-cdc-d-security"
        }
      },
      "required": [
        "request_bytes",
        "response_bytes",
        "read_timeout_seconds",
        "write_timeout_seconds",
        "confirmation_expiry_seconds",
        "nonce_bits",
        "nonce_encoding",
        "canonicalization",
        "tls_minimum",
        "tls_preferred",
        "redaction_max_depth",
        "redaction_max_bytes"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "dsn_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "max_slot_wal_keep_size_bytes": {
          "const": 68719476736,
          "description": "// M0-PROVISIONAL: boring-cdc-d-wal-cap"
        }
      },
      "required": [
        "dsn_env",
        "max_slot_wal_keep_size_bytes"
      ],
      "type": "object"
    }
  },
  "required": [
    "source",
    "journal",
    "limits",
    "failure_policy",
    "security"
  ],
  "title": "Boring CDC configuration scaffold",
  "type": "object"
}
