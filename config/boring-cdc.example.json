{
  "failure_policy": {
    "base_ms": 250,
    "cap_ms": 30000,
    "max_attempts": 10,
    "version": 1
  },
  "journal": {
    "busy_timeout_ms": 5000,
    "max_readers": 16,
    "path": "state/boring-cdc.sqlite3",
    "sqlite_version": "3.45.3"
  },
  "limits": {
    "event_bytes": 8388608,
    "key_bytes": 1024,
    "row_bytes": 4194304,
    "scalar_bytes": 1048576
  },
  "security": {
    "canonicalization": "RFC8785-JCS-SHA256",
    "confirmation_expiry_seconds": 300,
    "nonce_bits": 128,
    "nonce_encoding": "base64url-unpadded",
    "read_timeout_seconds": 10,
    "redaction_max_bytes": 65536,
    "redaction_max_depth": 8,
    "request_bytes": 1048576,
    "response_bytes": 4194304,
    "tls_minimum": "1.2",
    "tls_preferred": "1.3",
    "write_timeout_seconds": 30
  },
  "source": {
    "dsn_env": "BORING_CDC_SOURCE_DSN",
    "max_slot_wal_keep_size_bytes": 68719476736
  }
}
