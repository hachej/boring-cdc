{
  "$id": "https://boring-cdc.dev/contracts/agent/impact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "conflicts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actual": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "owner_bead": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "expected",
          "actual",
          "owner_bead"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "historical_closed": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "remediation": {
      "type": "string"
    },
    "schema_version": {
      "const": "impact/v1"
    },
    "source_digest": {
      "type": "string"
    },
    "stale_open_or_in_progress": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "target": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "target",
    "source_digest",
    "affected_ids",
    "stale_open_or_in_progress",
    "historical_closed",
    "conflicts",
    "remediation"
  ],
  "title": "Source impact and staleness projection",
  "type": "object"
}
