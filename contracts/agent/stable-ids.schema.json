{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://boring-cdc.dev/contracts/agent/stable-ids.schema.json","title":"Canonical stable ID registry","type":"object","additionalProperties":false,"required":["schema_version","source_files","entries"],"properties":{"schema_version":{"const":"stable-registry/v1"},"source_files":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","namespace","owner_bead","source","source_locator","source_digest","evidence_status","summary"],"properties":{"id":{"type":"string","pattern":"^(REQ|INV|DEC|CMD|COND|TRANS|SCN|REL|RISK|RUNBOOK|CLAIM|FINDING)-[A-Z0-9-]+$"},"namespace":{"enum":["REQ","INV","DEC","CMD","COND","TRANS","SCN","REL","RISK","RUNBOOK","CLAIM","FINDING"]},"owner_bead":{"type":"string","pattern":"^boring-cdc-[A-Za-z0-9.-]+$"},"source":{"type":"string","minLength":1},"source_locator":{"type":"string","minLength":1},"source_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_status":{"const":"pending"},"summary":{"type":"string","minLength":1}}}}}}
