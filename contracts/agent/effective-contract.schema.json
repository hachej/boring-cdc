{
  "$id": "https://boring-cdc.dev/contracts/agent/effective-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_status": {
            "const": "pending"
          },
          "id": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "owner_bead": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_anchor": {
            "type": "string"
          },
          "source_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_excerpt": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "namespace",
          "owner_bead",
          "source",
          "source_locator",
          "source_digest",
          "source_excerpt",
          "source_anchor",
          "evidence_status",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "common_policy": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "const": "agent-common-policy/v1"
        }
      },
      "required": [
        "version",
        "owner",
        "source",
        "digest"
      ],
      "type": "object"
    },
    "graph_snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "materialization_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_bead": {
      "type": "string"
    },
    "schema_version": {
      "const": "effective-contract/v1"
    },
    "source_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "task": {
      "minProperties": 3,
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "owner_bead",
    "graph_snapshot_digest",
    "task",
    "common_policy",
    "assignments",
    "source_digests",
    "materialization_digest"
  ],
  "title": "Fully materialized effective work contract",
  "type": "object"
}
