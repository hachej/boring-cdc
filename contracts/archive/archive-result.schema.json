{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "executor_id",
    "status",
    "observed",
    "redacted"
  ],
  "properties": {
    "schema_version": {
      "const": "archive-result/v1"
    },
    "fixture_id": {
      "type": "string"
    },
    "executor_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_state",
        "checkpoint_journal_seq",
        "promotion_fence",
        "manifest_sha256",
        "journal_verified_range",
        "self_consistent_range"
      ],
      "properties": {
        "archive_state": {
          "type": "string"
        },
        "checkpoint_journal_seq": {
          "type": "integer"
        },
        "promotion_fence": {
          "type": "integer"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "journal_verified_range": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "self_consistent_range": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "redacted": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive executor result"
}
