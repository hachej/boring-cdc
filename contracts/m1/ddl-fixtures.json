  "cases": [
    {
      "expected": "bounded catalog poll changes the fingerprint; nullable/no-default addition is the sole in-place admission outside a generation",
      "id": "SCN-IDLE-NO-ROW-DDL"
    },
    {
      "expected": "every admitted matrix operation waits on ACCESS SHARE on PostgreSQL 15/16/17",
      "id": "SCN-DDL-DURING-ACTIVE-BACKFILL"
    },
    {
      "expected": "guard is held before export, during export/copy, and until the matching fence is durable",
      "id": "SCN-DDL-IMMEDIATELY-BEFORE-AFTER-COPY-FENCE"
    },
    {
      "expected": "generation becomes invalid, feedback gate releases, old chunks cannot promote",
      "id": "SCN-IMPORTER-DDL-GUARD-LOSS"
    },
    {
      "expected": "a conflicting waiter at 5000 ms raises BACKFILL_DDL_WAITER and releases the lock queue",
      "id": "SCN-M1-DDL-WAITER-BOUND"
    },
    {
      "expected": "changed Relation blocks following DML decode and transaction feedback until catalog validation",
      "id": "SCN-M1-DDL-IMMEDIATE-RELATION-DML"
    }
  ],
