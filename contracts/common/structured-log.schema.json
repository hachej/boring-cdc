{
  "$id": "https://boring-cdc.dev/contracts/common/structured-log.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "level": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string"
    },
    "schema_version": {
      "const": "structured-log/v1"
    }
  },
  "required": [
    "schema_version",
    "level",
    "code",
    "correlation_id",
    "message"
  ],
  "title": "Redacted structured log",
  "type": "object"
}
